// Inventory Stock Management - Prisma Schema
// PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  ADMIN
  MANAGER
  USER
  VIEWER
}

// Approval status enum
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// User model for authentication
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Supplier master
model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  contact   String?  @db.Text
  email     String?
  phone     String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockItem[]

  @@map("suppliers")
}

// 5.1 Stock List (Items Master) - Static item registry
// NO quantity stored here
model StockItem {
  id         String    @id @default(uuid())
  itemName   String    @unique(map: "StockItem_itemName_key")
  supplier   String    // Display name (synced from Supplier when supplierId set)
  supplierId String?   @map("supplier_id")
  unit       String
  unitPrice  Decimal   @map("unit_price")
  itemType   String?   @default("Other") @map("item_type") // Asset, Consumable, Other
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplierRef Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockIns    StockIn[]
  stockOuts   StockOut[]

  @@index([supplierId])
  @@map("stock_items")
}

// 5.2 Stock In - Incoming stock
model StockIn {
  id              String   @id @default(uuid())
  itemId          String   @map("item_id")
  receivedDate    DateTime @map("received_date")
  receivedQuarter String   @map("received_quarter")
  quantity        Int      // Must be > 0 (validated in API)
  specification   String?  @db.Text
  proofOfDelivery String?  @map("proof_of_delivery") // Stored file path
  createdAt       DateTime @default(now())

  item StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([receivedDate])
  @@map("stock_ins")
}

// 5.3 Stock Out - Stock requests
model StockOut {
  id               String          @id @default(uuid())
  itemId           String          @map("item_id")
  requestedDate    DateTime        @map("requested_date")
  requestedQuarter String          @map("requested_quarter")
  requestingPerson String          @map("requesting_person")
  requestReason    String          @map("request_reason") @db.Text
  quantity         Int             // Must be > 0 (validated in API)
  status           ApprovalStatus  @default(PENDING)
  approvedBy       String?         @map("approved_by")
  approvedAt       DateTime?       @map("approved_at")
  rejectionReason  String?         @map("rejection_reason") @db.Text
  createdAt        DateTime        @default(now())

  item StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([requestedDate])
  @@index([status])
  @@map("stock_outs")
}
